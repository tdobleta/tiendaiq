{
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.0",
    "ajv": "^8.17.1",
    "cloudflared": "^0.7.1",
    "esbuild": "^0.28.1",
    "pg": "^8.22.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "verificar": "node pruebas/sintaxis.js",
    "coherencia": "node pruebas/coherencia.js",
    "unidad": "node --test pruebas/*.test.js",
    "humo": "node pruebas/humo.js",
    "db:migrate": "node scripts/migrar-db.js",
    "db:migrate:check": "node scripts/migrar-db.js --dry-run",
    "db:bind-shopify-registration": "node scripts/vincular-registro-shopify.js",
    "db:test:rls": "node scripts/probar-rls.js",
    "db:test:integration": "npm run db:migrate && npm run db:migrate && npm run db:test:rls",
    "carga:mock": "node scripts/servidor-carga-local.js",
    "carga:http": "node scripts/carga-local.js",
    "carga:cola": "node scripts/probar-capacidad-cola.js",
    "carga:anthropic": "node scripts/probar-capacidad-anthropic.js",
    "ops:readiness": "node scripts/probar-readiness-operativa.js",
    "ops:requeue-compensation": "node scripts/reencolar-compensacion.js",
    "audit:legacy-review-avatars": "node scripts/inventariar-avatares-publicados.js",
    "probar": "npm run verificar && npm run coherencia && node scripts/construir-render.js --verificar && node scripts/construir-editor.js --verificar && npm run unidad && npm run humo",
    "construir:render": "node scripts/construir-render.js",
    "construir:editor": "node scripts/construir-editor.js",
    "construir": "node scripts/construir-render.js && node scripts/construir-editor.js"
  },
  "engines": {
    "node": ">=20"
  }
}
