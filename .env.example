# Credenciales de la tienda de prueba (solo para el CLI y el modo dev local).
SHOPIFY_STORE=tu-tienda.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
SHOPIFY_APP_HANDLE=tiendaiq-app
# Identidad estable no secreta del registro Shopify que puede usar esta base.
# No usar client id, handle ni un id de provider/billing para este contrato.
SHOPIFY_APP_REGISTRATION_ID=tiendaiq-development-v1
# Preparación compatible: 1 bloquea runtime si DB e ID no coinciden.
SHOPIFY_APP_REGISTRATION_BINDING_ENFORCED=0
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
TOKEN_ENC_KEY=base64_de_32_bytes_generado_con_openssl_rand_base64_32
DATABASE_URL=postgresql://usuario:clave@localhost:5432/tiendaiq?sslmode=disable
# Sólo el comando de migraciones usa esta credencial propietaria.
MIGRATION_DATABASE_URL=postgresql://migrador:clave@localhost:5432/tiendaiq?sslmode=disable
# En el servicio worker, DATABASE_URL debe contener la credencial worker.
TEST_WORKER_DATABASE_URL=postgresql://worker:clave@localhost:5432/tiendaiq?sslmode=disable
PG_CA_CERT=
SHOPIFY_TIMEOUT_MS=30000
SHOPIFY_OAUTH_TIMEOUT_MS=15000
ANTHROPIC_TIMEOUT_MS=120000
TEXT_EDIT_CONCURRENCY=4
PUBLIC_BUNDLES_CACHE_MS=60000
GENERATION_QUEUE_MAX_PER_TENANT=2
GENERATION_QUEUE_MAX_GLOBAL=120
PG_POOL_MAX=10

# Solo staging: endpoints HTTP sinteticos sin Shopify, IA, billing ni escrituras.
# Mantener ausentes en produccion. El token debe tener al menos 32 caracteres.
ENABLE_SYNTHETIC_LOAD_ENDPOINTS=0
SYNTHETIC_LOAD_ENVIRONMENT=
SYNTHETIC_LOAD_TOKEN=
SYNTHETIC_LOAD_EXPIRES_AT=

# Solo web de staging: evidencia E2E activa de una development store fijada.
# El page ID es el identificador interno de una pagina real publicada por el worker.
SHOPIFY_CERTIFICATION_ENABLED=0
SHOPIFY_CERTIFICATION_SHOP=
SHOPIFY_CERTIFICATION_PAGE_ID=
SHOPIFY_CERTIFICATION_MAX_AGE_HOURS=24

# Capacidad del worker. Ocho generaciones cubren aproximadamente 500/hora si
# cada una tarda 40 s; confirmar primero el rate limit real de Anthropic.
JOB_GENERATION_CONCURRENCY=8
JOB_PUBLICATION_CONCURRENCY=4
WEBHOOK_CONCURRENCY=2
JOB_POLL_MS=1000
JOB_LEASE_SECONDS=300

# Datos del titular que se completan en las páginas legales (/privacidad y
# /terminos) al servirlas. Son URLs públicas de la ficha del App Store: si
# faltan, el review lo devuelve. En producción van en el panel de Render.
EMAIL_SOPORTE=soporte@tudominio.com
RAZON_SOCIAL=Nombre o razón social del titular
DOMICILIO=Domicilio completo, Ciudad, País

# Modelo y esfuerzo de la generación de páginas (opcionales; hay defaults).
#   MODELO_IA=claude-sonnet-5      (default) más barato, misma calidad de visión
#   MODELO_IA=claude-opus-4-8      el más capaz, ~2-3x más caro
#   ESFUERZO_IA=medium             (default) low | medium | high | xhigh | max
MODELO_IA=claude-sonnet-5
ESFUERZO_IA=medium

# "Inspírate de los mejores" — galería de videos de venta orgánica.
#   INSPIRACION_DIR    carpeta LOCAL con los .mp4 (modo dev/fallback). Los .mp4
#                      no se versionan; en su lugar se suben a Cloudinary.
#   CLOUDINARY_*       hosting en la nube (CDN + poster automático) para que la
#                      galería se vea en PRODUCCIÓN para los merchants. Crear una
#                      cuenta gratis en cloudinary.com → Dashboard copia estos 3
#                      valores. Luego: node scripts/subir-inspiracion.js
INSPIRACION_DIR=C:\ruta\a\INSPIRACION ORGANICO
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
