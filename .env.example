# Credenciales de la tienda de prueba (solo para el CLI y el modo dev local).
SHOPIFY_STORE=tu-tienda.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Datos del titular que se completan en las páginas legales (/privacidad y
# /terminos) al servirlas. Son URLs públicas de la ficha del App Store: si
# faltan, el review lo devuelve. En producción van en el panel de Render.
EMAIL_SOPORTE=soporte@tudominio.com
RAZON_SOCIAL=Nombre o razón social del titular
DOMICILIO=Domicilio completo, Ciudad, País

# Modelo y esfuerzo de la generación de páginas (opcionales; hay defaults).
#   MODELO_IA=claude-sonnet-5      (default) más barato, misma calidad de visión
#   MODELO_IA=claude-opus-4-8      el más capaz, ~2-3x más caro
#   ESFUERZO_IA=medium             (default) low | medium | high | xhigh | max
MODELO_IA=claude-sonnet-5
ESFUERZO_IA=medium
