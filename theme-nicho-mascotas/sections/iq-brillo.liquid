{%- comment -%} TiendaIQ — Showcase "Brillo": aurora animada + orbes de luz + shimmer dorado en el título + destello en el CTA. Efecto de vitrina premium. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .iq-br {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.fondo }};
    padding: {{ section.settings.padding }}px 2rem;
    text-align: center;
    isolation: isolate;
  }
  #shopify-section-{{ section.id }} .iq-br__aurora {
    position: absolute; inset: -30%;
    z-index: -2;
    background:
      radial-gradient(38% 45% at 20% 30%, {{ section.settings.aurora_a }}, transparent 60%),
      radial-gradient(42% 50% at 80% 25%, {{ section.settings.aurora_b }}, transparent 62%),
      radial-gradient(46% 55% at 55% 85%, {{ section.settings.aurora_c }}, transparent 60%);
    filter: blur(28px);
    animation: iq-br-aurora 16s ease-in-out infinite alternate;
  }
  #shopify-section-{{ section.id }} .iq-br__orbe {
    position: absolute; border-radius: 50%; z-index: -1;
    filter: blur(6px); opacity: .6;
    background: radial-gradient(circle at 35% 35%, {{ section.settings.orbe }}, transparent 70%);
  }
  #shopify-section-{{ section.id }} .iq-br__orbe--1 { width: 120px; height: 120px; left: 8%;  top: 22%; animation: iq-br-flota 9s ease-in-out infinite; }
  #shopify-section-{{ section.id }} .iq-br__orbe--2 { width: 70px;  height: 70px;  right: 12%; top: 30%; animation: iq-br-flota 7s ease-in-out infinite reverse; }
  #shopify-section-{{ section.id }} .iq-br__orbe--3 { width: 46px;  height: 46px;  right: 26%; bottom: 18%; animation: iq-br-flota 11s ease-in-out infinite; }
  #shopify-section-{{ section.id }} .iq-br__eyebrow {
    font-size: 1.2rem; letter-spacing: .28em; text-transform: uppercase;
    color: {{ section.settings.acento }}; font-weight: 700; margin: 0 0 1.4rem;
  }
  #shopify-section-{{ section.id }} .iq-br__title {
    margin: 0 auto 1.6rem; max-width: 22ch;
    background: linear-gradient(100deg, {{ section.settings.texto }} 30%, {{ section.settings.acento }} 45%, {{ section.settings.brillo }} 50%, {{ section.settings.acento }} 55%, {{ section.settings.texto }} 70%);
    background-size: 250% 100%;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    animation: iq-br-shimmer 6s linear infinite;
  }
  #shopify-section-{{ section.id }} .iq-br__sub {
    color: {{ section.settings.texto }}; opacity: .82; font-size: 1.7rem;
    max-width: 46ch; margin: 0 auto 2.6rem; line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .iq-br__cta {
    position: relative; overflow: hidden;
    display: inline-block; text-decoration: none;
    background: {{ section.settings.acento }}; color: {{ section.settings.cta_texto }};
    font-weight: 700; letter-spacing: .04em;
    padding: 1.4rem 3.4rem; border-radius: 999px;
    transition: transform .25s ease, box-shadow .25s ease;
    box-shadow: 0 10px 30px -8px {{ section.settings.acento }};
  }
  #shopify-section-{{ section.id }} .iq-br__cta:hover { transform: translateY(-2px); box-shadow: 0 16px 40px -8px {{ section.settings.acento }}; }
  #shopify-section-{{ section.id }} .iq-br__cta::after {
    content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.65), transparent);
    transform: skewX(-20deg);
    animation: iq-br-destello 3.5s ease-in-out infinite;
  }
  @keyframes iq-br-aurora {
    from { transform: translate3d(-2%, -1%, 0) scale(1); }
    to   { transform: translate3d(3%, 2%, 0) scale(1.12); }
  }
  @keyframes iq-br-flota {
    0%,100% { transform: translateY(0) translateX(0); }
    50%     { transform: translateY(-18px) translateX(8px); }
  }
  @keyframes iq-br-shimmer { from { background-position: 200% 0; } to { background-position: -50% 0; } }
  @keyframes iq-br-destello { 0%, 60% { left: -60%; } 100% { left: 130%; } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .iq-br__aurora,
    #shopify-section-{{ section.id }} .iq-br__orbe,
    #shopify-section-{{ section.id }} .iq-br__title,
    #shopify-section-{{ section.id }} .iq-br__cta::after { animation: none; }
    #shopify-section-{{ section.id }} .iq-br__title { -webkit-text-fill-color: {{ section.settings.texto }}; color: {{ section.settings.texto }}; }
  }
</style>
<div class="iq-br scroll-trigger animate--slide-in" data-cascade>
  <div class="iq-br__aurora" aria-hidden="true"></div>
  <span class="iq-br__orbe iq-br__orbe--1" aria-hidden="true"></span>
  <span class="iq-br__orbe iq-br__orbe--2" aria-hidden="true"></span>
  <span class="iq-br__orbe iq-br__orbe--3" aria-hidden="true"></span>
  {%- if section.settings.eyebrow != blank -%}<p class="iq-br__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.title != blank -%}<h2 class="iq-br__title h0">{{ section.settings.title }}</h2>{%- endif -%}
  {%- if section.settings.subtitle != blank -%}<p class="iq-br__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
  {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link | default: '#' }}" class="iq-br__cta">{{ section.settings.cta_label }}</a>{%- endif -%}
</div>
{% schema %}
{
  "name": "IQ Brillo",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Edición limitada" },
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Tu ritual de belleza, elevado" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Tecnología de oro 24K que realza tu piel en minutos. Sentí la diferencia desde el primer uso." },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Quiero el mío" },
    { "type": "url", "id": "cta_link", "label": "Link del botón" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "fondo", "label": "Fondo", "default": "#140d04" },
    { "type": "color", "id": "texto", "label": "Texto", "default": "#F5EAD6" },
    { "type": "color", "id": "acento", "label": "Acento / CTA", "default": "#C79A3B" },
    { "type": "color", "id": "cta_texto", "label": "Texto del CTA", "default": "#140d04" },
    { "type": "color", "id": "brillo", "label": "Brillo del título", "default": "#FBEFC9" },
    { "type": "color", "id": "orbe", "label": "Orbes de luz", "default": "#E7C77A" },
    { "type": "color", "id": "aurora_a", "label": "Aurora 1", "default": "#5a3d12" },
    { "type": "color", "id": "aurora_b", "label": "Aurora 2", "default": "#8a5a1f" },
    { "type": "color", "id": "aurora_c", "label": "Aurora 3", "default": "#3a2708" },
    { "type": "range", "id": "padding", "min": 60, "max": 200, "step": 10, "unit": "px", "label": "Alto (padding)", "default": 120 }
  ],
  "presets": [{ "name": "IQ Brillo" }]
}
{% endschema %}
