{%- comment -%}
  TiendaIQ — Sistema tipográfico único para todos los nichos.
  Títulos: Bricolage Grotesque (grotesca pesada, look DTC). Cuerpo: DM Sans.
  Pisa las variables de fuente de Dawn (--font-heading-family / --font-body-family)
  DESPUÉS de que Dawn las declara, así aplica a TODO el theme (todas las secciones)
  sin tocar cada sección una por una. Regla del proyecto: una sola tipografía,
  igual para todos los nichos. Ver memoria plantilla-diseno-decisiones.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=DM+Sans:opsz,wght@9..40,400..700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"></noscript>
<style>
  :root {
    /* Cuerpo → DM Sans */
    --font-body-family: "DM Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-body-style: normal;
    --font-body-weight: 400;
    --font-body-weight-bold: 700;

    /* Títulos → Bricolage Grotesque, grotesca pesada */
    --font-heading-family: "Bricolage Grotesque", ui-sans-serif, system-ui, "Segoe UI", sans-serif;
    --font-heading-style: normal;
    --font-heading-weight: 800;
  }

  /* Pulido de titulares al estándar de la landing: pesado, tracking apretado. */
  h1, h2, h3,
  .h0, .h1, .h2, .h3,
  .product__title,
  .title,
  .banner__heading,
  .card__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.01em;
  }

  /* Los titulares más grandes cierran interlínea (look editorial DTC). */
  .h0, .h1, .banner__heading, .product__title {
    line-height: 1.1;
  }

  /* Tarjetas de producto: título y precio un poco más grandes y legibles. */
  .card__heading,
  .card-information .card__heading {
    font-size: calc(var(--font-heading-scale) * 1.6rem);
    line-height: 1.3;
  }
  .price,
  .card-information .price {
    font-size: 1.9rem;
  }
</style>
