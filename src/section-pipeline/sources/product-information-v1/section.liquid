{% liquid
  assign section_dom_id = 'product-hero-' | append: section.id | handleize
  comment
    The original instance was configured at 940px. Coerce Theme Editor range
    values to numbers before comparing them so older saved values reliably
    receive the reference desktop proportions.
  endcomment
  assign hero_max_width = section.settings.max_width | plus: 0
  if hero_max_width < 1100
    assign hero_max_width = 1200
  endif
  assign hero_column_gap = section.settings.column_gap | plus: 0
  if hero_column_gap < 48
    assign hero_column_gap = 50
  endif
  assign hero_desktop_top = section.settings.desktop_padding_top | plus: 0
  if hero_desktop_top < 40
    assign hero_desktop_top = 42
  endif
  assign hero_thumbnail_size = section.settings.thumbnail_size | plus: 0
  if hero_thumbnail_size < 64
    assign hero_thumbnail_size = 64
  endif
  assign hero_content_max_width = 600
  assign main_image_class = section_dom_id | append: '__main-image'
  assign thumbnail_image_class = section_dom_id | append: '__thumbnail-image'
  assign bundle_image_class = section_dom_id | append: '__bundle-image'
  assign reviewer_image_class = section_dom_id | append: '__reviewer-image'
  assign placeholder_svg_class = section_dom_id | append: '__placeholder-svg'
  assign thumbnail_placeholder_class = section_dom_id | append: '__thumbnail-placeholder'
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = blank

  if current_variant != blank
    assign featured_media = current_variant.featured_media
  endif

  if featured_media == blank and product != blank
    assign featured_media = product.featured_media
  endif

  assign featured_alt = section.settings.image_alt
  if featured_media != blank and featured_media.alt != blank
    assign featured_alt = featured_media.alt
  elsif product != blank and product.title != blank
    assign featured_alt = product.title
  endif

  assign cta_href = section.settings.button_link
  if cta_href == blank and product != blank
    assign cta_href = product.url
  endif
  if cta_href == blank
    assign cta_href = '#'
  endif

  assign rating_text_display = section.settings.rating_text | replace: 'Rated 4.9', 'Calificación 4.9' | replace: '‘Excellent’', '«Excelente»'

  assign reviews_label_display = '693+ Reseñas'

  assign description_display = section.settings.description | replace: 'Advanced support for men 40+', 'Apoyo avanzado para hombres de más de 40 años' | replace: 'helping restore', 'ayuda a recuperar' | replace: 'cellular energy', 'energía celular' | replace: 'clarity, and overall vitality', 'la claridad y el bienestar general'

  assign bundle_heading_display = section.settings.bundle_heading | replace: 'BUNDLE & SAVE', 'COMPRA Y AHORRA'

  assign urgency_text_display = section.settings.urgency_text | replace: 'Order Now To Receive It By September 10', 'Haz tu pedido ahora y recíbelo antes del 10 de septiembre' | replace: 'Order Now To Receive It By September 9', 'Haz tu pedido ahora y recíbelo antes del 9 de septiembre'

  assign button_label_display = section.settings.button_label | replace: 'ADD TO CART', 'AÑADIR AL CARRITO'

  assign cta_icon_display = section.settings.button_icon
  if cta_icon_display == '♧'
    assign cta_icon_display = 'cart'
  endif

  assign first_bundle_price = blank
  assign first_bundle_compare = blank
  for block in section.blocks
    if block.type == 'bundle' and first_bundle_price == blank
      assign first_bundle_price = block.settings.price
      assign first_bundle_compare = block.settings.compare_at_price
    endif
  endfor

  assign cta_price_display = blank
  assign cta_compare_display = blank
  if current_variant != blank
    assign cta_price_display = current_variant.price | money
    if current_variant.compare_at_price > current_variant.price
      assign cta_compare_display = current_variant.compare_at_price | money
    endif
  elsif first_bundle_price != blank
    assign cta_price_display = first_bundle_price
    assign cta_compare_display = first_bundle_compare
  endif
%}

<!-- Product hero section: product media, offers, CTA, payment badges and tabs. -->
<section
  id="{{ section_dom_id }}"
  class="{{ section_dom_id }}"
  style="
    --hero-max-width: {{ hero_max_width }}px;
    --hero-content-max-width: {{ hero_content_max_width }}px;
    --hero-media-width: {{ section.settings.media_width }}%;
    --hero-column-gap: {{ hero_column_gap }}px;
    --hero-card-gap: {{ section.settings.card_gap }}px;
    --hero-media-gap: 8px;
    --hero-thumbnail-size: {{ hero_thumbnail_size }}px;
    --hero-desktop-top: {{ hero_desktop_top }}px;
    --hero-desktop-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --hero-mobile-top: {{ section.settings.mobile_padding_top }}px;
    --hero-mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --hero-desktop-side: {{ section.settings.desktop_side_padding }}px;
    --hero-mobile-side: {{ section.settings.mobile_side_padding }}px;
    --hero-media-radius: 0px;
    --hero-panel-radius: 6px;
    --hero-background: {{ section.settings.background_color }};
    --hero-media-background: {{ section.settings.media_background_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-heading: {{ section.settings.heading_color }};
    --hero-muted: {{ section.settings.muted_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-border: {{ section.settings.border_color }};
    --hero-panel: {{ section.settings.panel_color }};
    --hero-panel-alt: {{ section.settings.panel_alt_color }};
    --hero-button: {{ section.settings.button_color }};
    --hero-button-text: {{ section.settings.button_text_color }};
    --hero-success: {{ section.settings.success_color }};
    --hero-star: {{ section.settings.star_color }};
  "
>
  <div class="{{ section_dom_id }}__inner">
    <div class="{{ section_dom_id }}__grid">
      <!-- Product media gallery. The left column stays visible while the details scroll. -->
      <div class="{{ section_dom_id }}__media-column">
        <div class="{{ section_dom_id }}__media-stage">
          {% if featured_media != blank %}
            {{ featured_media.preview_image | image_url: width: 1600 | image_tag: class: main_image_class, widths: '540, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'eager', alt: featured_alt }}
          {% elsif section.settings.hero_image != blank %}
            {{ section.settings.hero_image | image_url: width: 1600 | image_tag: class: main_image_class, widths: '540, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'eager', alt: section.settings.image_alt }}
          {% else %}
            <div class="{{ section_dom_id }}__media-placeholder" role="img" aria-label="{{ section.settings.image_alt | escape }}">
              {{ 'product-1' | placeholder_svg_tag: placeholder_svg_class }}
            </div>
          {% endif %}
        </div>

        {% if product != blank and product.media.size > 0 %}
          <div class="{{ section_dom_id }}__thumbnails" role="list" aria-label="Imágenes del producto">
            {% for media in product.media %}
              {% assign media_preview = media.preview_image %}
              {% assign media_alt = media.alt | default: product.title | default: section.settings.image_alt %}
              {% if media_preview != blank %}
                <button
                  type="button"
                  class="{{ section_dom_id }}__thumbnail {% if featured_media != blank and media.id == featured_media.id %}{{ section_dom_id }}__thumbnail--active{% endif %}"
                  data-thumb
                  data-image="{{ media_preview | image_url: width: 1600 }}"
                  data-alt="{{ media_alt | escape }}"
                  aria-label="Ver {{ media_alt | escape }}"
                  aria-current="{% if featured_media != blank and media.id == featured_media.id %}true{% else %}false{% endif %}"
                >
                  {{ media_preview | image_url: width: 220 | image_tag: class: thumbnail_image_class, loading: 'lazy', alt: media_alt }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          {% assign media_thumb_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'media_thumb' %}
              {% assign media_thumb_count = media_thumb_count | plus: 1 %}
            {% endif %}
          {% endfor %}
          {% if media_thumb_count > 0 %}
            <div class="{{ section_dom_id }}__thumbnails" role="list" aria-label="Imágenes del producto">
              {% assign media_thumb_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'media_thumb' %}
                  {% assign media_thumb_index = media_thumb_index | plus: 1 %}
                  <button
                    type="button"
                    class="{{ section_dom_id }}__thumbnail {% if media_thumb_index == 1 %}{{ section_dom_id }}__thumbnail--active{% endif %}"
                    data-thumb
                    data-image="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1600 }}{% endif %}"
                    data-alt="{{ block.settings.alt | escape }}"
                    aria-label="{{ block.settings.button_label | escape }}"
                    aria-current="{% if media_thumb_index == 1 %}true{% else %}false{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 220 | image_tag: class: thumbnail_image_class, loading: 'lazy', alt: block.settings.alt }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: thumbnail_placeholder_class }}
                    {% endif %}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
      </div>

      <!-- Product information and conversion panel. -->
      <div class="{{ section_dom_id }}__details">
        <div class="{{ section_dom_id }}__rating-row">
          <span class="{{ section_dom_id }}__stars" aria-label="5 de 5 estrellas">{{ section.settings.rating_stars }}</span>
          <span>{{ rating_text_display | escape }}</span>
          {% if section.settings.reviews_link != blank %}
            <a href="{{ section.settings.reviews_link }}" class="{{ section_dom_id }}__reviews-link">{{ reviews_label_display }}</a>
          {% else %}
            <span class="{{ section_dom_id }}__reviews-link">{{ reviews_label_display }}</span>
          {% endif %}
        </div>

        <h1 class="{{ section_dom_id }}__title">{{ section.settings.heading | escape }}</h1>

        {% if section.settings.description != blank %}
          <div class="{{ section_dom_id }}__description">{{ description_display }}</div>
        {% endif %}

        {% assign benefit_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            {% assign benefit_count = benefit_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if benefit_count > 0 %}
          <div class="{{ section_dom_id }}__benefits" aria-label="Beneficios del producto">
            {% for block in section.blocks %}
              {% if block.type == 'benefit' %}
                {% assign benefit_text_display = block.settings.text | replace: 'Helps Prostate', 'Ayuda a la próstata' | replace: 'Balances Hormones', 'Equilibra las hormonas' | replace: 'Increases Stamina', 'Aumenta la resistencia' | replace: 'Improves Blood Flow', 'Mejora el flujo sanguíneo' %}
                <span class="{{ section_dom_id }}__benefit" {{ block.shopify_attributes }}>
                  <span class="{{ section_dom_id }}__benefit-icon" aria-hidden="true">{{ block.settings.icon_glyph }}</span>
                  <span>{{ benefit_text_display | escape }}</span>
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% assign bundle_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'bundle' %}
            {% assign bundle_count = bundle_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if bundle_count > 0 %}
          <div class="{{ section_dom_id }}__bundle-heading">
            <span></span>
            <strong>{{ bundle_heading_display | escape }}</strong>
            <span></span>
          </div>

          <div class="{{ section_dom_id }}__bundles" role="group" aria-label="Elige un paquete">
            {% assign bundle_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'bundle' %}
                {% assign bundle_index = bundle_index | plus: 1 %}
                {% assign bundle_selected = false %}
                {% if block.settings.selected or bundle_index == 1 %}
                  {% assign bundle_selected = true %}
                {% endif %}

                {% assign bundle_title_key = block.settings.title | downcase %}
                {% assign bundle_units = 1 %}
                {% if bundle_title_key contains 'buy 3' or bundle_title_key contains 'compra 3' %}
                  {% assign bundle_units = 5 %}
                {% elsif bundle_title_key contains 'buy 2' or bundle_title_key contains 'compra 2' %}
                  {% assign bundle_units = 3 %}
                {% endif %}

                {% assign bundle_price_display = block.settings.price %}
                {% assign bundle_compare_display = block.settings.compare_at_price %}
                {% assign bundle_subtitle_display = block.settings.subtitle %}
                {% if current_variant != blank %}
                  {% assign bundle_price_total = current_variant.price | times: bundle_units %}
                  {% assign bundle_price_display = bundle_price_total | money %}
                  {% if current_variant.compare_at_price > current_variant.price %}
                    {% assign bundle_compare_total = current_variant.compare_at_price | times: bundle_units %}
                    {% assign bundle_compare_display = bundle_compare_total | money %}
                    {% assign unit_savings = current_variant.compare_at_price | minus: current_variant.price %}
                    {% assign bundle_savings = unit_savings | times: bundle_units %}
                    {% capture bundle_subtitle_display %}Ahorra {{ bundle_savings | money }}{% endcapture %}
                  {% else %}
                    {% assign bundle_compare_display = blank %}
                    {% assign bundle_subtitle_display = blank %}
                  {% endif %}
                {% endif %}
                {% if bundle_subtitle_display contains 'You save' %}
                  {% assign bundle_subtitle_display = bundle_subtitle_display | replace: 'You save', 'Ahorra' %}
                {% endif %}

                {% assign bundle_title_display = block.settings.title | replace: 'BUY 1', 'COMPRA 1' | replace: 'BUY 2 GET 1 FREE', 'COMPRA 2 Y LLEVA 1 GRATIS' | replace: 'BUY 3 GET 2 FREE', 'COMPRA 3 Y LLEVA 2 GRATIS' %}
                {% assign bundle_badge_display = block.settings.badge | replace: 'Most Popular', 'MÁS POPULAR' | replace: 'Best Value', 'MEJOR VALOR' %}

                <button
                  type="button"
                  class="{{ section_dom_id }}__bundle {% if bundle_selected %}{{ section_dom_id }}__bundle--selected{% endif %}"
                  data-bundle
                  data-selected="{% if bundle_selected %}true{% else %}false{% endif %}"
                  data-price="{{ bundle_price_display | escape }}"
                  data-compare="{{ bundle_compare_display | escape }}"
                  aria-pressed="{% if bundle_selected %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 110 | image_tag: class: bundle_image_class, loading: 'lazy', alt: block.settings.image_alt }}
                  {% elsif featured_media != blank %}
                    {{ featured_media.preview_image | image_url: width: 110 | image_tag: class: bundle_image_class, loading: 'lazy', alt: featured_alt }}
                  {% else %}
                    <span class="{{ section_dom_id }}__bundle-image-placeholder" aria-hidden="true">{{ block.settings.image_placeholder }}</span>
                  {% endif %}
                  <span class="{{ section_dom_id }}__bundle-copy">
                    <span class="{{ section_dom_id }}__bundle-title">{{ bundle_title_display | escape }}</span>
                    {% if bundle_subtitle_display != blank %}
                      <span class="{{ section_dom_id }}__bundle-subtitle">{{ bundle_subtitle_display }}</span>
                    {% endif %}
                  </span>
                  <span class="{{ section_dom_id }}__bundle-prices">
                    <span class="{{ section_dom_id }}__bundle-price">{{ bundle_price_display }}</span>
                    {% if bundle_compare_display != blank %}
                      <s>{{ bundle_compare_display }}</s>
                    {% endif %}
                  </span>
                  {% if bundle_badge_display != blank %}
                    <span class="{{ section_dom_id }}__bundle-badge">{{ bundle_badge_display | escape }}</span>
                  {% endif %}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.urgency_text != blank %}
          <div class="{{ section_dom_id }}__urgency">
            <span aria-hidden="true"></span>
            <span>{{ urgency_text_display | escape }}</span>
          </div>
        {% endif %}

        <a
          class="{{ section_dom_id }}__cta"
          href="{{ cta_href }}"
          aria-label="{{ button_label_display | escape }}"
          data-cta
          data-variant-id="{% if current_variant != blank %}{{ current_variant.id }}{% endif %}"
        >
          <span class="{{ section_dom_id }}__cta-icon" aria-hidden="true">
            {% if cta_icon_display == 'cart' %}
              <svg viewBox="0 0 24 24" focusable="false"><path d="M3 4h2l2.2 10.2h10.7l2-7H7.1M9.3 20a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5Zm7.8 0a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5Z" /></svg>
            {% else %}
              {{ cta_icon_display }}
            {% endif %}
          </span>
          <span data-cta-label>{{ button_label_display | escape }}</span>
          {% if cta_price_display != blank %}
            <span data-cta-price> - {{ cta_price_display }}</span>
          {% endif %}
          <s data-cta-compare{% if cta_compare_display == blank %} hidden{% endif %}>{% if cta_compare_display != blank %}{{ cta_compare_display }}{% endif %}</s>
        </a>

        {% assign trust_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'trust_item' %}
            {% assign trust_count = trust_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if trust_count > 0 %}
          <div class="{{ section_dom_id }}__trust-row" aria-label="Beneficios de compra">
            {% for block in section.blocks %}
              {% if block.type == 'trust_item' %}
                {% assign trust_text_display = block.settings.text | replace: 'Fast Shipping', 'Envío rápido' | replace: '60-Day Guarantee', 'Garantía de 60 días' %}
                <span class="{{ section_dom_id }}__trust-item" {{ block.shopify_attributes }}>
                  <span class="{{ section_dom_id }}__trust-icon" aria-hidden="true">
                    {% if block.settings.icon_glyph == '♢' and trust_text_display contains 'Envío' %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10" /></svg>
                    {% elsif block.settings.icon_glyph == '♢' and trust_text_display contains 'Garantía' %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M5 8h14l-1 12H6L5 8Zm3 0V6a4 4 0 0 1 8 0v2m-6 6 1.4 1.4L15 12" /></svg>
                    {% else %}
                      {{ block.settings.icon_glyph }}
                    {% endif %}
                  </span>
                  <span>{{ trust_text_display | escape }}</span>
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% assign payment_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'payment' %}
            {% assign payment_count = payment_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if payment_count > 0 %}
          <div class="{{ section_dom_id }}__payments" aria-label="Métodos de pago aceptados">
            {% for block in section.blocks %}
              {% if block.type == 'payment' %}
                {% assign payment_width = block.settings.width | plus: 0 %}
                {% if payment_width < 30 %}
                  {% assign payment_width = 32 %}
                {% endif %}
                <span class="{{ section_dom_id }}__payment {{ section_dom_id }}__payment--{{ block.settings.label | handleize }}" style="--payment-width: {{ payment_width }}px;" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.alt }}
                  {% else %}
                    <span class="{{ section_dom_id }}__payment-placeholder {{ section_dom_id }}__payment-placeholder--{{ block.settings.style }}">{{ block.settings.label | escape }}</span>
                  {% endif %}
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% assign tab_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            {% assign tab_count = tab_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if tab_count > 0 %}
          <div class="{{ section_dom_id }}__tabs" data-tabs>
            <div class="{{ section_dom_id }}__tab-list" role="tablist" aria-label="Detalles del producto">
              {% assign tab_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'tab' %}
                  {% assign tab_index = tab_index | plus: 1 %}
                  {% assign tab_id = section_dom_id | append: '-tab-' | append: tab_index %}
                  {% assign panel_id = section_dom_id | append: '-panel-' | append: tab_index %}
                  {% assign tab_title_display = block.settings.title | replace: 'Reviews', 'Reseñas' | replace: 'Comparison', 'Comparación' | replace: 'Specifications', 'Especificaciones' %}
                  <button
                    type="button"
                    id="{{ tab_id }}"
                    class="{{ section_dom_id }}__tab"
                    role="tab"
                    aria-controls="{{ panel_id }}"
                    aria-selected="false"
                    tabindex="-1"
                    data-tab-button
                    data-panel-id="{{ panel_id }}"
                    data-active="{% if block.settings.active %}true{% else %}false{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ tab_title_display | escape }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>

            {% assign tab_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'tab' %}
                {% assign tab_index = tab_index | plus: 1 %}
                {% assign tab_id = section_dom_id | append: '-tab-' | append: tab_index %}
                {% assign panel_id = section_dom_id | append: '-panel-' | append: tab_index %}
                {% assign tab_layout = block.settings.layout %}
                {% assign tab_title_key = block.settings.title | downcase %}
                {% if tab_title_key contains 'compar' %}
                  {% assign tab_layout = 'comparison' %}
                {% elsif tab_title_key contains 'spec' or tab_title_key contains 'especific' %}
                  {% assign tab_layout = 'specification' %}
                {% endif %}
                <div
                  id="{{ panel_id }}"
                  class="{{ section_dom_id }}__tab-panel"
                  role="tabpanel"
                  aria-labelledby="{{ tab_id }}"
                  hidden
                  data-tab-panel
                  data-layout="{{ tab_layout }}"
                >
                  {% case tab_layout %}
                    {% when 'review' %}
                      {% assign review_rating_label_display = block.settings.rating_label | replace: '5 de 5 estrellas', '5 de 5 estrellas' %}
                      <div class="{{ section_dom_id }}__review-stars" aria-label="{{ review_rating_label_display | escape }}">{{ block.settings.rating_stars }}</div>
                      {% assign review_content_display = block.settings.content | replace: 'Completely changed my life!', '¡Me cambió la vida por completo!' %}
                      <div class="{{ section_dom_id }}__review-content">{{ review_content_display }}</div>
                      <div class="{{ section_dom_id }}__reviewer">
                        {% if block.settings.reviewer_image != blank %}
                          {{ block.settings.reviewer_image | image_url: width: 120 | image_tag: class: reviewer_image_class, loading: 'lazy', alt: block.settings.reviewer_image_alt }}
                        {% else %}
                          <span class="{{ section_dom_id }}__reviewer-initials" aria-hidden="true">{{ block.settings.reviewer_initials | escape }}</span>
                        {% endif %}
                        <span class="{{ section_dom_id }}__reviewer-copy">
                          <strong>{{ block.settings.reviewer_name | escape }}</strong>
                          {% assign reviewer_date_display = block.settings.reviewer_date | replace: 'January 23, 2026', '23 de enero de 2026' %}
                          {% assign reviewer_role_display = block.settings.reviewer_role | replace: 'PhD In Science', 'Doctorado en Ciencias' %}
                          <span>{{ reviewer_date_display | escape }}</span>
                          <small>{{ reviewer_role_display | escape }}</small>
                        </span>
                      </div>
                    {% when 'comparison' %}
                      {% assign comparison_us_display = block.settings.comparison_us_heading | replace: 'Us', 'Nosotros' %}
                      {% assign comparison_other_display = block.settings.comparison_other_heading | replace: 'Others', 'Otros' %}
                      <div class="{{ section_dom_id }}__comparison" role="table" aria-label="Comparación de productos">
                        <div class="{{ section_dom_id }}__comparison-head" role="row">
                          <span role="columnheader"></span>
                          <strong role="columnheader">{{ comparison_us_display | escape }}</strong>
                          <strong role="columnheader">{{ comparison_other_display | escape }}</strong>
                        </div>
                        {% for comparison_item in (1..3) %}
                          {% case comparison_item %}
                            {% when 1 %}{% assign item_text = block.settings.comparison_item_1 %}
                            {% when 2 %}{% assign item_text = block.settings.comparison_item_2 %}
                            {% when 3 %}{% assign item_text = block.settings.comparison_item_3 %}
                          {% endcase %}
                          {% assign item_text = item_text | replace: 'Studied', 'Estudiado' | replace: 'No Fillers', 'Sin rellenos' | replace: 'GMO-Compliant', 'Cumple con normas GMO' %}
                          {% assign comparison_yes_display = block.settings.comparison_yes_label | replace: 'Included', 'Incluido' %}
                          {% assign comparison_no_display = block.settings.comparison_no_label | replace: 'Not included', 'No incluido' %}
                          <div class="{{ section_dom_id }}__comparison-row" role="row">
