<script>
  /* Scoped vanilla JavaScript for the gallery, bundle selection and tabs. */
  (() => {
    const root = document.getElementById('{{ section_dom_id }}');
    if (!root) return;

    const mainImage = root.querySelector('.{{ section_dom_id }}__main-image');
    const thumbnails = Array.from(root.querySelectorAll('[data-thumb]'));
    const bundleOptions = Array.from(root.querySelectorAll('[data-bundle]'));
    const ctaPrice = root.querySelector('[data-cta-price]');
    const ctaCompare = root.querySelector('[data-cta-compare]');
    const cartQuantity = root.querySelector('[data-cart-quantity]');
    const tabButtons = Array.from(root.querySelectorAll('[data-tab-button]'));
    const tabPanels = Array.from(root.querySelectorAll('[data-tab-panel]'));

    const selectThumbnail = (thumbnail) => {
      if (!thumbnail || !mainImage) return;
      const imageUrl = thumbnail.getAttribute('data-image');
      if (!imageUrl) return;

      mainImage.classList.add('is-changing');
      window.setTimeout(() => {
        mainImage.src = imageUrl;
        mainImage.removeAttribute('srcset');
        mainImage.alt = thumbnail.getAttribute('data-alt') || mainImage.alt;
        window.requestAnimationFrame(() => mainImage.classList.remove('is-changing'));
      }, 140);

      thumbnails.forEach((item) => {
        const isActive = item === thumbnail;
        item.classList.toggle('{{ section_dom_id }}__thumbnail--active', isActive);
        item.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => selectThumbnail(thumbnail));
    });

    const setBundle = (option) => {
      if (!option) return;

      bundleOptions.forEach((item) => {
        const isSelected = item === option;
        item.classList.toggle('{{ section_dom_id }}__bundle--selected', isSelected);
        item.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });

      if (ctaPrice && option.dataset.price) {
        ctaPrice.textContent = ` - ${option.dataset.price}`;
      }

      if (ctaCompare) {
        const compare = option.dataset.compare || '';
        ctaCompare.textContent = compare;
        ctaCompare.hidden = !compare;
      }
      if (cartQuantity) cartQuantity.value = option.dataset.quantity || '1';
    };

    bundleOptions.forEach((option) => {
      option.addEventListener('click', () => setBundle(option));
    });

    setBundle(bundleOptions.find((option) => option.dataset.selected === 'true') || bundleOptions[0]);

    const activateTab = (button, shouldFocus) => {
      if (!button) return;

      tabButtons.forEach((tabButton) => {
        const isActive = tabButton === button;
        tabButton.classList.toggle('{{ section_dom_id }}__tab--active', isActive);
        tabButton.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tabButton.tabIndex = isActive ? 0 : -1;
      });

      tabPanels.forEach((panel) => {
        const isActive = panel.id === button.dataset.panelId;
        if (isActive) {
          panel.hidden = false;
          panel.classList.remove('{{ section_dom_id }}__tab-panel--visible');
          window.requestAnimationFrame(() => panel.classList.add('{{ section_dom_id }}__tab-panel--visible'));
        } else {
          panel.classList.remove('{{ section_dom_id }}__tab-panel--visible');
          window.setTimeout(() => {
            if (!panel.classList.contains('{{ section_dom_id }}__tab-panel--visible')) panel.hidden = true;
          }, 230);
        }
      });

      if (shouldFocus) button.focus();
    };

    tabButtons.forEach((button, index) => {
      button.addEventListener('click', () => activateTab(button, false));
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft' && event.key !== 'Home' && event.key !== 'End') return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabButtons.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabButtons.length) % tabButtons.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabButtons.length - 1;
        activateTab(tabButtons[nextIndex], true);
      });
    });

    activateTab(tabButtons.find((button) => button.dataset.active === 'true') || tabButtons[0], false);
  })();
</script>

