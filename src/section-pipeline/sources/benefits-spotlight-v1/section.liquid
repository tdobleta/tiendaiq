{% liquid
  assign section_dom_id = 'tiq-benefits-spotlight-' | append: section.id | handleize
  assign placeholder_class = section_dom_id | append: '__placeholder'
  assign background_style = ''
  if section.settings.background_image != blank
    assign background_style = 'background-image: url("' | append: section.settings.background_image | escape | append: '"); background-position: ' | append: section.settings.background_image_position | append: '; background-repeat: ' | append: section.settings.background_image_repeat | append: '; background-size: ' | append: section.settings.background_image_size | append: '; background-attachment: ' | append: section.settings.background_image_attachment | append: ';'
  endif
%}

<section id="{{ section_dom_id }}" class="{{ section_dom_id }}" style="{{ background_style }}" aria-labelledby="{{ section_dom_id }}-heading" data-tiq-outline-id="{{ section_dom_id }}__section">
  {% if section.settings.background_overlay_show %}<span class="{{ section_dom_id }}__overlay" aria-hidden="true"></span>{% endif %}
  <div class="{{ section_dom_id }}__inner">
    <header class="{{ section_dom_id }}__header" data-tiq-outline-id="{{ section_dom_id }}__header">
      {% if section.settings.eyebrow != blank %}<p class="{{ section_dom_id }}__eyebrow" data-tiq-outline-id="{{ section_dom_id }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="{{ section_dom_id }}-heading" class="{{ section_dom_id }}__heading" data-tiq-outline-id="{{ section_dom_id }}__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="{{ section_dom_id }}__intro rte" data-tiq-outline-id="{{ section_dom_id }}__intro">{{ section.settings.intro }}</div>{% endif %}
    </header>
    <div class="{{ section_dom_id }}__spotlight" data-tiq-outline-id="{{ section_dom_id }}__spotlight">
      <div class="{{ section_dom_id }}__benefits {{ section_dom_id }}__benefits--left" aria-label="{{ section.settings.benefits_label | escape }}" data-tiq-outline-id="{{ section_dom_id }}__benefits-left">
        {% assign left_count = 0 %}
        {% for block in section.blocks %}
          {% assign position = block.settings.position | default: 'auto' %}
          {% if position == 'left-top' or position == 'left-bottom' or position == 'auto' and left_count < 2 %}
            {% assign left_count = left_count | plus: 1 %}
            <article class="{{ section_dom_id }}__benefit {{ section_dom_id }}__benefit--{{ position }}" {{ block.shopify_attributes }}>
              <span class="{{ section_dom_id }}__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
              <div class="{{ section_dom_id }}__copy">
                {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
                {% if block.settings.body != blank %}<div class="{{ section_dom_id }}__body rte">{{ block.settings.body }}</div>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
      <div class="{{ section_dom_id }}__media" data-tiq-outline-id="{{ section_dom_id }}__media">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | escape }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="1200">
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}
      </div>
      <div class="{{ section_dom_id }}__benefits {{ section_dom_id }}__benefits--right" aria-label="{{ section.settings.benefits_label | escape }}" data-tiq-outline-id="{{ section_dom_id }}__benefits-right">
        {% assign right_count = 0 %}
        {% for block in section.blocks %}
          {% assign position = block.settings.position | default: 'auto' %}
          {% if position == 'right-top' or position == 'right-bottom' or position == 'auto' and right_count < 2 and left_count == 2 %}
            {% assign right_count = right_count | plus: 1 %}
            <article class="{{ section_dom_id }}__benefit {{ section_dom_id }}__benefit--{{ position }}" {{ block.shopify_attributes }}>
              <span class="{{ section_dom_id }}__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
              <div class="{{ section_dom_id }}__copy">
                {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
                {% if block.settings.body != blank %}<div class="{{ section_dom_id }}__body rte">{{ block.settings.body }}</div>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  #{{ section_dom_id }} { --tiq-bs-bg: {{ section.settings.background_color }}; --tiq-bs-heading: {{ section.settings.heading_color }}; --tiq-bs-text: {{ section.settings.text_color }}; --tiq-bs-muted: {{ section.settings.muted_color }}; --tiq-bs-accent: {{ section.settings.accent_color }}; --tiq-bs-card: {{ section.settings.card_background }}; --tiq-bs-border: {{ section.settings.border_color }}; --tiq-bs-media-bg: {{ section.settings.media_background }}; --tiq-bs-overlay: {{ section.settings.background_overlay_color }}; position: relative; overflow: hidden; width: 100%; background-color: var(--tiq-bs-bg); color: var(--tiq-bs-text); }
  #{{ section_dom_id }} * { box-sizing: border-box; }
  #{{ section_dom_id }} .{{ section_dom_id }}__overlay { position: absolute; inset: 0; background: var(--tiq-bs-overlay); opacity: .42; pointer-events: none; }
  #{{ section_dom_id }} .{{ section_dom_id }}__inner { position: relative; z-index: 1; width: min(100%, {{ section.settings.max_width }}px); margin: {{ section.settings.margin_top }}px auto {{ section.settings.margin_bottom }}px; padding: {{ section.settings.padding_top }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom }}px; }
  #{{ section_dom_id }} .{{ section_dom_id }}__header { max-width: 900px; margin: 0 auto 38px; text-align: {{ section.settings.heading_align }}; }
  #{{ section_dom_id }} .{{ section_dom_id }}__eyebrow { margin: 0 0 10px; color: var(--tiq-bs-accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; line-height: 1.3; text-transform: uppercase; }
  #{{ section_dom_id }} .{{ section_dom_id }}__heading { margin: 0; color: var(--tiq-bs-heading); font-size: clamp(30px, 4.2vw, 54px); font-weight: 700; letter-spacing: -.04em; line-height: 1.04; }
  #{{ section_dom_id }} .{{ section_dom_id }}__intro { max-width: 700px; margin: 14px auto 0; color: var(--tiq-bs-muted); font-size: 16px; line-height: 1.55; }
  #{{ section_dom_id }} .{{ section_dom_id }}__intro p { margin: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__spotlight { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 32%) minmax(0, 1fr); align-items: center; gap: {{ section.settings.column_gap }}px; padding: {{ section.settings.spotlight_padding }}px; border: 1px solid var(--tiq-bs-border); border-radius: {{ section.settings.border_radius }}px; background: color-mix(in srgb, var(--tiq-bs-card) 72%, transparent); }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefits { display: grid; gap: {{ section.settings.benefit_gap }}px; min-width: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left { text-align: right; }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefits--right { text-align: left; }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefit { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 14px; align-items: center; min-width: 0; padding: 14px; border: 1px solid transparent; border-radius: {{ section.settings.benefit_radius }}px; background: color-mix(in srgb, var(--tiq-bs-card) 88%, transparent); }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left .{{ section_dom_id }}__benefit { grid-template-columns: minmax(0, 1fr) 48px; }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left .{{ section_dom_id }}__copy { grid-column: 1; grid-row: 1; }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left .{{ section_dom_id }}__icon { grid-column: 2; grid-row: 1; }
  #{{ section_dom_id }} .{{ section_dom_id }}__icon { display: grid; width: 48px; height: 48px; place-items: center; border: 1px solid color-mix(in srgb, var(--tiq-bs-accent) 25%, transparent); border-radius: 50%; background: color-mix(in srgb, var(--tiq-bs-accent) 16%, transparent); color: var(--tiq-bs-accent); font-size: 21px; line-height: 1; }
  #{{ section_dom_id }} .{{ section_dom_id }}__copy { min-width: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__copy h3 { margin: 0; color: var(--tiq-bs-heading); font-size: 18px; font-weight: 700; line-height: 1.25; }
  #{{ section_dom_id }} .{{ section_dom_id }}__body { margin-top: 6px; color: var(--tiq-bs-muted); font-size: 14px; line-height: 1.45; }
  #{{ section_dom_id }} .{{ section_dom_id }}__body p { margin: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__media { display: grid; width: 100%; aspect-ratio: 1; place-items: center; overflow: hidden; border-radius: 50%; background: var(--tiq-bs-media-bg); }
  #{{ section_dom_id }} .{{ section_dom_id }}__media img, #{{ section_dom_id }} .{{ section_dom_id }}__media svg { display: block; width: 100%; height: 100%; object-fit: {{ section.settings.image_fit }}; }
  #{{ section_dom_id }} .{{ section_dom_id }}__media svg { padding: 24%; }
  @media (max-width: 989px) { #{{ section_dom_id }} .{{ section_dom_id }}__spotlight { grid-template-columns: 1fr 1fr; gap: {{ section.settings.mobile_gap }}px; } #{{ section_dom_id }} .{{ section_dom_id }}__media { grid-column: 1 / -1; grid-row: 1; width: min(68vw, 330px); margin: 0 auto; } #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left { grid-column: 1; grid-row: 2; } #{{ section_dom_id }} .{{ section_dom_id }}__benefits--right { grid-column: 2; grid-row: 2; } }
  @media (max-width: 749px) { #{{ section_dom_id }} .{{ section_dom_id }}__inner { margin-top: {{ section.settings.mobile_margin_top }}px; margin-bottom: {{ section.settings.mobile_margin_bottom }}px; padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_side_padding }}px {{ section.settings.mobile_padding_bottom }}px; } #{{ section_dom_id }} .{{ section_dom_id }}__header { margin-bottom: 26px; } #{{ section_dom_id }} .{{ section_dom_id }}__heading { font-size: clamp(30px, 10vw, 42px); } #{{ section_dom_id }} .{{ section_dom_id }}__intro { font-size: 15px; } #{{ section_dom_id }} .{{ section_dom_id }}__spotlight { grid-template-columns: 1fr; gap: {{ section.settings.mobile_gap }}px; padding: {{ section.settings.mobile_spotlight_padding }}px; } #{{ section_dom_id }} .{{ section_dom_id }}__media { grid-column: auto; grid-row: auto; width: min(76vw, 300px); } #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left, #{{ section_dom_id }} .{{ section_dom_id }}__benefits--right { grid-column: auto; grid-row: auto; text-align: left; } #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left .{{ section_dom_id }}__benefit { grid-template-columns: 48px minmax(0, 1fr); } #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left .{{ section_dom_id }}__copy { grid-column: 2; } #{{ section_dom_id }} .{{ section_dom_id }}__benefits--left .{{ section_dom_id }}__icon { grid-column: 1; } }
</style>

{% schema %}
{
  "name": "Beneficios destacados",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "BENEFICIOS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Una mejor experiencia, visible desde el primer día" },
    { "type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>Descubrí las ventajas que hacen que este producto encaje naturalmente en tu rutina.</p>" },
    { "type": "text", "id": "benefits_label", "label": "Etiqueta accesible", "default": "Beneficios del producto" },
    { "type": "header", "content": "Imagen y composición" },
    { "type": "image_picker", "id": "image", "label": "Imagen central" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo", "default": "Imagen del producto" },
    { "type": "select", "id": "image_fit", "label": "Ajuste de imagen", "options": [{ "value": "cover", "label": "Llenar área" }, { "value": "contain", "label": "Mostrar completa" }], "default": "cover" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1180 },
    { "type": "range", "id": "column_gap", "label": "Separación lateral", "min": 16, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "benefit_gap", "label": "Separación entre beneficios", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "spotlight_padding", "label": "Padding de composición", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 34 },
    { "type": "range", "id": "mobile_gap", "label": "Separación móvil", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 22 },
    { "type": "range", "id": "mobile_spotlight_padding", "label": "Padding móvil de composición", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 18 },
    { "type": "header", "content": "Fondo y estilo" },
    { "type": "color", "id": "background_color", "label": "Fondo", "default": "#1B385D" },
    { "type": "color", "id": "card_background", "label": "Fondo de composición", "default": "#173252" },
    { "type": "color", "id": "media_background", "label": "Fondo de imagen", "default": "#EAF0D7" },
    { "type": "color", "id": "heading_color", "label": "Título", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "muted_color", "label": "Texto secundario", "default": "#D4E1EF" },
    { "type": "color", "id": "accent_color", "label": "Acento", "default": "#DCEBA6" },
    { "type": "color", "id": "border_color", "label": "Borde", "default": "#31557D" },
    { "type": "image_picker", "id": "background_image", "label": "Imagen de fondo" },
    { "type": "select", "id": "background_image_position", "label": "Posición de fondo", "options": [{ "value": "top", "label": "Arriba" }, { "value": "center", "label": "Centro" }, { "value": "bottom", "label": "Abajo" }], "default": "center" },
    { "type": "select", "id": "background_image_repeat", "label": "Repetición de fondo", "options": [{ "value": "no-repeat", "label": "No repetir" }, { "value": "repeat", "label": "Repetir" }], "default": "no-repeat" },
    { "type": "select", "id": "background_image_size", "label": "Tamaño de fondo", "options": [{ "value": "cover", "label": "Cubrir" }, { "value": "contain", "label": "Contener" }, { "value": "auto", "label": "Automático" }], "default": "cover" },
    { "type": "select", "id": "background_image_attachment", "label": "Fijación de fondo", "options": [{ "value": "scroll", "label": "Local" }, { "value": "fixed", "label": "Fijo" }], "default": "scroll" },
    { "type": "checkbox", "id": "background_overlay_show", "label": "Mostrar capa sobre el fondo", "default": false },
    { "type": "color", "id": "background_overlay_color", "label": "Color de la capa", "default": "#000000" },
    { "type": "select", "id": "heading_align", "label": "Alineación del título", "options": [{ "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" }], "default": "center" },
    { "type": "range", "id": "border_radius", "label": "Radio de composición", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "benefit_radius", "label": "Radio de beneficios", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Padding superior escritorio", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding inferior escritorio", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "side_padding", "label": "Padding lateral escritorio", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "margin_top", "label": "Margin superior escritorio", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin inferior escritorio", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding superior móvil", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding inferior móvil", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_side_padding", "label": "Padding lateral móvil", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_margin_top", "label": "Margin superior móvil", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_bottom", "label": "Margin inferior móvil", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [{ "type": "benefit", "name": "Beneficio", "limit": 6, "settings": [
    { "type": "text", "id": "icon", "label": "Icono", "default": "✓" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Una ventaja para tu rutina" },
    { "type": "richtext", "id": "body", "label": "Descripción", "default": "<p>Explicá de forma clara cómo se vive este beneficio.</p>" },
    { "type": "select", "id": "position", "label": "Ubicación", "options": [{ "value": "auto", "label": "Automática" }, { "value": "left-top", "label": "Izquierda arriba" }, { "value": "left-bottom", "label": "Izquierda abajo" }, { "value": "right-top", "label": "Derecha arriba" }, { "value": "right-bottom", "label": "Derecha abajo" }], "default": "auto" }
  ]}],
  "presets": [{ "name": "Beneficios destacados", "settings": { "heading": "Elevá tu rutina con una solución pensada para vos" }, "blocks": [
    { "type": "benefit", "settings": { "icon": "◷", "heading": "Más simple cada día", "position": "left-top" } },
    { "type": "benefit", "settings": { "icon": "✦", "heading": "Más confianza al usarlo", "position": "left-bottom" } },
    { "type": "benefit", "settings": { "icon": "♡", "heading": "Comodidad sostenida", "position": "right-top" } },
    { "type": "benefit", "settings": { "icon": "◇", "heading": "Diseñado para durar", "position": "right-bottom" } }
  ]}]
}
{% endschema %}
