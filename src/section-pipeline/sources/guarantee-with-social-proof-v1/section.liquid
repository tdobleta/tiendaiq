{% liquid
  assign section_dom_id = 'tiq-guarantee-social-' | append: section.id | handleize
%}

<section id="{{ section_dom_id }}" class="{{ section_dom_id }}" aria-labelledby="{{ section_dom_id }}-heading">
  <div class="{{ section_dom_id }}__inner">
    <div class="{{ section_dom_id }}__mark" aria-hidden="true">✓</div>
    <div class="{{ section_dom_id }}__content">
      {% if section.settings.eyebrow != blank %}<p class="{{ section_dom_id }}__eyebrow" data-tiq-outline-id="{{ section_dom_id }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="{{ section_dom_id }}-heading" class="{{ section_dom_id }}__heading" data-tiq-outline-id="{{ section_dom_id }}__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.body != blank %}<div class="{{ section_dom_id }}__body rte" data-tiq-outline-id="{{ section_dom_id }}__body">{{ section.settings.body }}</div>{% endif %}
      {% if section.blocks.size > 0 %}
        <ul class="{{ section_dom_id }}__items" aria-label="{{ section.settings.items_label | escape }}" data-tiq-outline-id="{{ section_dom_id }}__items">
          {% for block in section.blocks %}
            <li class="{{ section_dom_id }}__item" {{ block.shopify_attributes }}>
              <span class="{{ section_dom_id }}__item-icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
              <span class="{{ section_dom_id }}__item-copy">
                {% if block.settings.heading != blank %}<strong>{{ block.settings.heading | escape }}</strong>{% endif %}
                {% if block.settings.body != blank %}<span>{{ block.settings.body | escape }}</span>{% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="{{ section_dom_id }}__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #{{ section_dom_id }} {
    --tiq-guarantee-bg: {{ section.settings.background_color }};
    --tiq-guarantee-card: {{ section.settings.card_background }};
    --tiq-guarantee-heading: {{ section.settings.heading_color }};
    --tiq-guarantee-text: {{ section.settings.text_color }};
    --tiq-guarantee-muted: {{ section.settings.muted_color }};
    --tiq-guarantee-accent: {{ section.settings.accent_color }};
    --tiq-guarantee-border: {{ section.settings.border_color }};
    --tiq-guarantee-radius: {{ section.settings.card_radius }}px;
    width: 100%;
    background: var(--tiq-guarantee-bg);
    color: var(--tiq-guarantee-text);
  }
  #{{ section_dom_id }} * { box-sizing: border-box; }
  #{{ section_dom_id }} .{{ section_dom_id }}__inner {
    width: min(100%, {{ section.settings.max_width }}px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 72px minmax(0, 720px);
    gap: 24px;
    align-items: start;
    padding: {{ section.settings.padding_top }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom }}px;
  }
  #{{ section_dom_id }} .{{ section_dom_id }}__mark {
    display: grid;
    width: 72px;
    height: 72px;
    place-items: center;
    border: 1px solid var(--tiq-guarantee-border);
    border-radius: 50%;
    background: color-mix(in srgb, var(--tiq-guarantee-accent) 14%, transparent);
    color: var(--tiq-guarantee-accent);
    font-size: 32px;
    font-weight: 700;
  }
  #{{ section_dom_id }} .{{ section_dom_id }}__content { min-width: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__eyebrow { margin: 0 0 10px; color: var(--tiq-guarantee-accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; line-height: 1.3; text-transform: uppercase; }
  #{{ section_dom_id }} .{{ section_dom_id }}__heading { margin: 0; color: var(--tiq-guarantee-heading); font-size: clamp(28px, 4vw, 48px); font-weight: 700; letter-spacing: -.035em; line-height: 1.05; }
  #{{ section_dom_id }} .{{ section_dom_id }}__body { margin-top: 14px; color: var(--tiq-guarantee-muted); font-size: 16px; line-height: 1.55; }
  #{{ section_dom_id }} .{{ section_dom_id }}__body p { margin: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 24px 0 0; padding: 0; list-style: none; }
  #{{ section_dom_id }} .{{ section_dom_id }}__item { display: flex; gap: 10px; min-width: 0; padding: 12px; border: 1px solid var(--tiq-guarantee-border); border-radius: calc(var(--tiq-guarantee-radius) * .75); background: var(--tiq-guarantee-card); }
  #{{ section_dom_id }} .{{ section_dom_id }}__item-icon { flex: 0 0 auto; color: var(--tiq-guarantee-accent); font-size: 18px; line-height: 1.2; }
  #{{ section_dom_id }} .{{ section_dom_id }}__item-copy { display: grid; gap: 3px; min-width: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__item-copy strong { color: var(--tiq-guarantee-heading); font-size: 14px; line-height: 1.25; }
  #{{ section_dom_id }} .{{ section_dom_id }}__item-copy span { color: var(--tiq-guarantee-muted); font-size: 13px; line-height: 1.4; }
  #{{ section_dom_id }} .{{ section_dom_id }}__button { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; margin-top: 24px; padding: 12px 24px; border-radius: calc(var(--tiq-guarantee-radius) * .7); background: var(--tiq-guarantee-accent); color: #fff; font-size: 14px; font-weight: 700; text-decoration: none; transition: filter .2s ease, transform .2s ease; }
  #{{ section_dom_id }} .{{ section_dom_id }}__button:hover { filter: brightness(1.08); transform: translateY(-1px); }
  #{{ section_dom_id }} .{{ section_dom_id }}__button:focus-visible { outline: 2px solid var(--tiq-guarantee-heading); outline-offset: 3px; }
  @media (max-width: 749px) {
    #{{ section_dom_id }} .{{ section_dom_id }}__inner { grid-template-columns: 1fr; gap: 16px; padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_side_padding }}px {{ section.settings.mobile_padding_bottom }}px; }
    #{{ section_dom_id }} .{{ section_dom_id }}__mark { width: 56px; height: 56px; font-size: 25px; }
    #{{ section_dom_id }} .{{ section_dom_id }}__body { font-size: 15px; }
    #{{ section_dom_id }} .{{ section_dom_id }}__items { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Garantía con prueba social",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "COMPRA SIN RIESGO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu compra está protegida" },
    { "type": "richtext", "id": "body", "label": "Descripción", "default": "<p>Estamos tan seguros de la experiencia que ofrecemos una garantía de satisfacción para que puedas decidir con tranquilidad.</p>" },
    { "type": "text", "id": "items_label", "label": "Etiqueta accesible de elementos", "default": "Razones para comprar con confianza" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón", "default": "/products" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo", "min": 720, "max": 1400, "step": 20, "unit": "px", "default": 980 },
    { "type": "range", "id": "padding_top", "label": "Padding superior escritorio", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding inferior escritorio", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "side_padding", "label": "Padding lateral escritorio", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding superior móvil", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding inferior móvil", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_side_padding", "label": "Padding lateral móvil", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "header", "content": "Apariencia" },
    { "type": "color", "id": "background_color", "label": "Fondo", "default": "#101722" },
    { "type": "color", "id": "card_background", "label": "Fondo de elementos", "default": "#17243A" },
    { "type": "color", "id": "heading_color", "label": "Título", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "muted_color", "label": "Texto secundario", "default": "#D4E1EF" },
    { "type": "color", "id": "accent_color", "label": "Acento", "default": "#2E82FF" },
    { "type": "color", "id": "border_color", "label": "Borde", "default": "#31557D" },
    { "type": "range", "id": "card_radius", "label": "Radio", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "blocks": [
    { "type": "trust_item", "name": "Elemento de confianza", "limit": 4, "settings": [
      { "type": "text", "id": "icon", "label": "Icono", "default": "✓" },
      { "type": "text", "id": "heading", "label": "Título", "default": "Garantía de satisfacción" },
      { "type": "text", "id": "body", "label": "Descripción", "default": "Decidí con tranquilidad y respaldo." }
    ] }
  ],
  "presets": [
    { "name": "Garantía con prueba social", "blocks": [
      { "type": "trust_item", "settings": { "icon": "✓", "heading": "Garantía de satisfacción", "body": "Decidí con tranquilidad y respaldo." } },
      { "type": "trust_item", "settings": { "icon": "★", "heading": "Calidad cuidada", "body": "Una experiencia pensada para tu rutina." } },
      { "type": "trust_item", "settings": { "icon": "↻", "heading": "Compra protegida", "body": "Soporte cuando lo necesitás." } }
    ] }
  ]
}
{% endschema %}
