{% liquid
  assign section_dom_id = 'tiq-image-benefits-' | append: section.id | handleize
  assign placeholder_class = section_dom_id | append: '__placeholder'
%}

<section id="{{ section_dom_id }}" class="{{ section_dom_id }}" aria-labelledby="{{ section_dom_id }}-heading">
  <div class="{{ section_dom_id }}__inner">
    <div class="{{ section_dom_id }}__media" data-tiq-outline-id="{{ section_dom_id }}__media">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | escape }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="1500">
      {% else %}
        {{ 'image' | placeholder_svg_tag: placeholder_class }}
      {% endif %}
    </div>
    <div class="{{ section_dom_id }}__content">
      {% if section.settings.eyebrow != blank %}<p class="{{ section_dom_id }}__eyebrow" data-tiq-outline-id="{{ section_dom_id }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="{{ section_dom_id }}-heading" class="{{ section_dom_id }}__heading" data-tiq-outline-id="{{ section_dom_id }}__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="{{ section_dom_id }}__intro rte" data-tiq-outline-id="{{ section_dom_id }}__intro">{{ section.settings.intro }}</div>{% endif %}
      {% if section.blocks.size > 0 %}
        <ul class="{{ section_dom_id }}__benefits" aria-label="{{ section.settings.benefits_label | escape }}" data-tiq-outline-id="{{ section_dom_id }}__benefits">
          {% for block in section.blocks %}
            <li class="{{ section_dom_id }}__benefit" {{ block.shopify_attributes }}>
              <span class="{{ section_dom_id }}__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
              <div class="{{ section_dom_id }}__copy">
                {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
                {% if block.settings.body != blank %}<div class="{{ section_dom_id }}__body rte">{{ block.settings.body }}</div>{% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #{{ section_dom_id }} { --tiq-benefits-bg: {{ section.settings.background_color }}; --tiq-benefits-heading: {{ section.settings.heading_color }}; --tiq-benefits-text: {{ section.settings.text_color }}; --tiq-benefits-muted: {{ section.settings.muted_color }}; --tiq-benefits-accent: {{ section.settings.accent_color }}; --tiq-benefits-border: {{ section.settings.border_color }}; --tiq-benefits-card: {{ section.settings.card_background }}; --tiq-benefits-media-bg: {{ section.settings.media_background }}; --tiq-benefits-radius: {{ section.settings.card_radius }}px; --tiq-benefits-gap: {{ section.settings.column_gap }}px; --tiq-benefits-media-width: {{ section.settings.media_width }}%; width: 100%; background: var(--tiq-benefits-bg); color: var(--tiq-benefits-text); }
  #{{ section_dom_id }} * { box-sizing: border-box; }
  #{{ section_dom_id }} .{{ section_dom_id }}__inner { width: min(100%, {{ section.settings.max_width }}px); margin: 0 auto; display: grid; grid-template-columns: minmax(0, var(--tiq-benefits-media-width)) minmax(0, calc(100% - var(--tiq-benefits-media-width) - var(--tiq-benefits-gap))); align-items: center; gap: var(--tiq-benefits-gap); padding: {{ section.settings.padding_top }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom }}px; }
  #{{ section_dom_id }} .{{ section_dom_id }}__media { min-width: 0; overflow: hidden; order: {% if section.settings.image_position == 'last' %}2{% else %}1{% endif %}; border-radius: var(--tiq-benefits-radius); background: var(--tiq-benefits-media-bg); }
  #{{ section_dom_id }} .{{ section_dom_id }}__media img, #{{ section_dom_id }} .{{ section_dom_id }}__media svg { display: block; width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: {{ section.settings.image_fit }}; }
  #{{ section_dom_id }} .{{ section_dom_id }}__content { min-width: 0; max-width: 640px; order: {% if section.settings.image_position == 'last' %}1{% else %}2{% endif %}; }
  #{{ section_dom_id }} .{{ section_dom_id }}__eyebrow { margin: 0 0 10px; color: var(--tiq-benefits-accent); font-size: 12px; font-weight: 700; letter-spacing: .13em; line-height: 1.3; text-transform: uppercase; }
  #{{ section_dom_id }} .{{ section_dom_id }}__heading { margin: 0; color: var(--tiq-benefits-heading); font-size: clamp(30px, 4.2vw, 54px); font-weight: 700; letter-spacing: -.04em; line-height: 1.02; }
  #{{ section_dom_id }} .{{ section_dom_id }}__intro { margin-top: 16px; color: var(--tiq-benefits-muted); font-size: 16px; line-height: 1.55; }
  #{{ section_dom_id }} .{{ section_dom_id }}__intro p { margin: 0; }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefits { display: grid; gap: {{ section.settings.benefit_gap }}px; margin: 28px 0 0; padding: 0; list-style: none; }
  #{{ section_dom_id }} .{{ section_dom_id }}__benefit { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px; align-items: start; padding: 14px; border: 1px solid var(--tiq-benefits-border); border-radius: calc(var(--tiq-benefits-radius) * .75); background: var(--tiq-benefits-card); }
  #{{ section_dom_id }} .{{ section_dom_id }}__icon { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--tiq-benefits-accent) 12%, transparent); color: var(--tiq-benefits-accent); font-size: 19px; line-height: 1; }
  #{{ section_dom_id }} .{{ section_dom_id }}__copy { min-width: 0; padding-top: 2px; }
  #{{ section_dom_id }} .{{ section_dom_id }}__copy h3 { margin: 0; color: var(--tiq-benefits-heading); font-size: 18px; font-weight: 700; line-height: 1.25; }
  #{{ section_dom_id }} .{{ section_dom_id }}__body { margin-top: 5px; color: var(--tiq-benefits-muted); font-size: 14px; line-height: 1.45; }
  #{{ section_dom_id }} .{{ section_dom_id }}__body p { margin: 0; }
  @media (max-width: 749px) { #{{ section_dom_id }} .{{ section_dom_id }}__inner { grid-template-columns: 1fr; gap: {{ section.settings.mobile_gap }}px; padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_side_padding }}px {{ section.settings.mobile_padding_bottom }}px; } #{{ section_dom_id }} .{{ section_dom_id }}__content { max-width: none; } #{{ section_dom_id }} .{{ section_dom_id }}__heading { font-size: clamp(30px, 10vw, 42px); } #{{ section_dom_id }} .{{ section_dom_id }}__intro { font-size: 15px; } #{{ section_dom_id }} .{{ section_dom_id }}__media { order: {% if section.settings.mobile_media_position == 'last' %}2{% else %}1{% endif %}; } #{{ section_dom_id }} .{{ section_dom_id }}__content { order: {% if section.settings.mobile_media_position == 'last' %}1{% else %}2{% endif %}; } }
</style>

{% schema %}
{
  "name": "Imagen con beneficios",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "BENEFICIOS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo lo que necesitás para sentirte mejor" },
    { "type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>Una composición flexible para explicar por qué tu producto forma parte de una rutina mejor.</p>" },
    { "type": "text", "id": "benefits_label", "label": "Etiqueta accesible de beneficios", "default": "Beneficios del producto" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo de la imagen", "default": "Imagen del producto" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1160 },
    { "type": "range", "id": "media_width", "label": "Ancho de imagen", "min": 30, "max": 55, "step": 1, "unit": "%", "default": 42 },
    { "type": "range", "id": "column_gap", "label": "Separación entre columnas", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "benefit_gap", "label": "Separación entre beneficios", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "select", "id": "image_position", "label": "Imagen en escritorio", "options": [{ "value": "first", "label": "Antes del contenido" }, { "value": "last", "label": "Después del contenido" }], "default": "first" },
    { "type": "select", "id": "image_fit", "label": "Ajuste de imagen", "options": [{ "value": "cover", "label": "Llenar área" }, { "value": "contain", "label": "Mostrar imagen completa" }], "default": "cover" },
    { "type": "select", "id": "mobile_media_position", "label": "Imagen en móvil", "options": [{ "value": "first", "label": "Antes del contenido" }, { "value": "last", "label": "Después del contenido" }], "default": "first" },
    { "type": "range", "id": "padding_top", "label": "Padding superior escritorio", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding inferior escritorio", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "side_padding", "label": "Padding lateral escritorio", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_gap", "label": "Separación móvil", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding superior móvil", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding inferior móvil", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_side_padding", "label": "Padding lateral móvil", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "header", "content": "Apariencia" },
    { "type": "color", "id": "background_color", "label": "Fondo", "default": "#1B385D" },
    { "type": "color", "id": "media_background", "label": "Fondo de imagen", "default": "#6E89A6" },
    { "type": "color", "id": "card_background", "label": "Fondo de beneficio", "default": "#173252" },
    { "type": "color", "id": "heading_color", "label": "Título", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "muted_color", "label": "Texto secundario", "default": "#D4E1EF" },
    { "type": "color", "id": "accent_color", "label": "Acento", "default": "#2E82FF" },
    { "type": "color", "id": "border_color", "label": "Borde", "default": "#31557D" },
    { "type": "range", "id": "card_radius", "label": "Radio de tarjetas", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "blocks": [{ "type": "benefit", "name": "Beneficio", "limit": 6, "settings": [
    { "type": "text", "id": "icon", "label": "Icono", "default": "✓" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Una rutina más simple" },
    { "type": "richtext", "id": "body", "label": "Descripción", "default": "<p>Explicá de forma clara el beneficio que el producto aporta.</p>" }
  ]}],
  "presets": [{ "name": "Imagen con beneficios", "blocks": [
    { "type": "benefit", "settings": { "icon": "✓", "heading": "Más simple cada día" } },
    { "type": "benefit", "settings": { "icon": "★", "heading": "Diseñado para tu rutina" } },
    { "type": "benefit", "settings": { "icon": "↗", "heading": "Una experiencia consistente" } }
  ]}]
}
{% endschema %}
