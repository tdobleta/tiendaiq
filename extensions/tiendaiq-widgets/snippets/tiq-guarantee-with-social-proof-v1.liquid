{% comment %}gen guarantee-with-social-proof@1 29618c62f445cdfe66217e2db5ed18345e042237f5469e1cb41bd5b6b592fd90{% endcomment %}
{% liquid
assign section_dom_id = 'tiq-guarantee-social-' | append: tiq_section.id | handleize%}
<section id="{{section_dom_id}}" class="{{section_dom_id}}" aria-labelledby="{{section_dom_id}}-heading"><div class="{{section_dom_id}}__inner"><div class="{{section_dom_id}}__mark" aria-hidden="true">✓</div><div class="{{section_dom_id}}__content">
{% if tiq_section.instance.settings.eyebrow != blank%}<p class="{{section_dom_id}}__eyebrow" data-tiq-outline-id="{{section_dom_id}}__eyebrow">{{tiq_section.instance.settings.eyebrow | escape}}</p>{% endif%}
{% if tiq_section.instance.settings.heading != blank%}<h2 id="{{section_dom_id}}-heading" class="{{section_dom_id}}__heading" data-tiq-outline-id="{{section_dom_id}}__heading">{{tiq_section.instance.settings.heading | escape}}</h2>{% endif%}
{% if tiq_section.instance.settings.body != blank%}<div class="{{section_dom_id}}__body rte" data-tiq-outline-id="{{section_dom_id}}__body">{{tiq_section.instance.settings.body}}</div>{% endif%}
{% if tiq_section.instance.blocks.size > 0%}
<ul class="{{section_dom_id}}__items" aria-label="{{tiq_section.instance.settings.items_label | escape}}" data-tiq-outline-id="{{section_dom_id}}__items">
{% for block in tiq_section.instance.blocks%}<li class="{{section_dom_id}}__item" data-tiq-block-id="{{block.id | escape}}"><span class="{{section_dom_id}}__item-icon" aria-hidden="true">{{block.settings.icon | escape}}</span><span class="{{section_dom_id}}__item-copy">{% if block.settings.heading != blank%}<strong>{{block.settings.heading | escape}}</strong>{% endif%}{% if block.settings.body != blank%}<span>{{block.settings.body | escape}}</span>{% endif%}</span></li>{% endfor%}
</ul>
{% endif%}
{% if tiq_section.instance.settings.button_label != blank%}<a class="{{section_dom_id}}__button" href="{{tiq_section.instance.settings.button_link}}" data-tiq-outline-id="{{section_dom_id}}__button">{{tiq_section.instance.settings.button_label | escape}}</a>{% endif%}
</div></div></section><style>#{{section_dom_id}}{--g-bg:{{tiq_section.instance.settings.background_color}};--g-card:{{tiq_section.instance.settings.card_background}};--g-heading:{{tiq_section.instance.settings.heading_color}};--g-text:{{tiq_section.instance.settings.text_color}};--g-muted:{{tiq_section.instance.settings.muted_color}};--g-accent:{{tiq_section.instance.settings.accent_color}};--g-border:{{tiq_section.instance.settings.border_color}};--g-radius:{{tiq_section.instance.settings.card_radius}}px;width:100%;background:var(--g-bg);color:var(--g-text)}#{{section_dom_id}} *{box-sizing:border-box}#{{section_dom_id}} .{{section_dom_id}}__inner{width:min(100%,{{tiq_section.instance.settings.max_width}}px);margin:auto;display:grid;grid-template-columns:64px minmax(0,720px);gap:20px;align-items:start;padding:{{tiq_section.instance.settings.padding_top}}px {{tiq_section.instance.settings.side_padding}}px {{tiq_section.instance.settings.padding_bottom}}px}#{{section_dom_id}} .{{section_dom_id}}__mark{display:grid;width:64px;height:64px;place-items:center;border:1px solid var(--g-border);border-radius:50%;background:color-mix(in srgb,var(--g-accent)14%,transparent);color:var(--g-accent);font-size:28px;font-weight:700}#{{section_dom_id}} .{{section_dom_id}}__content{min-width:0}#{{section_dom_id}} .{{section_dom_id}}__eyebrow{margin:0 0 8px;color:var(--g-accent);font-size:11px;font-weight:700;letter-spacing:.14em;line-height:1.3;text-transform:uppercase}#{{section_dom_id}} .{{section_dom_id}}__heading{margin:0;color:var(--g-heading);font-size:clamp(28px,4vw,46px);font-weight:700;letter-spacing:-.035em;line-height:1.05}#{{section_dom_id}} .{{section_dom_id}}__body{margin-top:12px;color:var(--g-muted);font-size:16px;line-height:1.5}#{{section_dom_id}} .{{section_dom_id}}__body p{margin:0}#{{section_dom_id}} .{{section_dom_id}}__items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:20px 0 0;padding:0;list-style:none}#{{section_dom_id}} .{{section_dom_id}}__item{display:flex;gap:9px;min-width:0;padding:11px;border:1px solid var(--g-border);border-radius:calc(var(--g-radius)* .75);background:var(--g-card)}#{{section_dom_id}} .{{section_dom_id}}__item-icon{flex:0 0 auto;color:var(--g-accent);font-size:17px;line-height:1.2}#{{section_dom_id}} .{{section_dom_id}}__item-copy{display:grid;gap:2px;min-width:0}#{{section_dom_id}} .{{section_dom_id}}__item-copy strong{color:var(--g-heading);font-size:13px;line-height:1.25}#{{section_dom_id}} .{{section_dom_id}}__item-copy span{color:var(--g-muted);font-size:12px;line-height:1.35}#{{section_dom_id}} .{{section_dom_id}}__button{display:inline-flex;min-height:44px;align-items:center;justify-content:center;margin-top:20px;padding:11px 22px;border-radius:calc(var(--g-radius)* .7);background:var(--g-accent);color:#fff;font-size:13px;font-weight:700;text-decoration:none;transition:filter .2s ease,transform .2s ease}#{{section_dom_id}} .{{section_dom_id}}__button:hover{filter:brightness(1.08);transform:translateY(-1px)}#{{section_dom_id}} .{{section_dom_id}}__button:focus-visible{outline:2px solid var(--g-heading);outline-offset:3px}@media(max-width:749px){#{{section_dom_id}} .{{section_dom_id}}__inner{grid-template-columns:1fr;gap:14px;padding:{{tiq_section.instance.settings.mobile_padding_top}}px {{tiq_section.instance.settings.mobile_side_padding}}px {{tiq_section.instance.settings.mobile_padding_bottom}}px}#{{section_dom_id}} .{{section_dom_id}}__mark{width:52px;height:52px;font-size:23px}#{{section_dom_id}} .{{section_dom_id}}__body{font-size:15px}#{{section_dom_id}} .{{section_dom_id}}__items{grid-template-columns:1fr}}</style>
