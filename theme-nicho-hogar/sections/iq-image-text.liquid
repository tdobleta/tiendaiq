{%- comment -%} TiendaIQ — Imagen + texto con imagen desde assets del theme (pack por nicho) {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .iq-imgtext__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .iq-imgtext--reverse .iq-imgtext__media { order: 2; }
  #shopify-section-{{ section.id }} .iq-imgtext__media img {
    width: 100%;
    height: auto;
    border-radius: var(--media-radius, 20px);
    display: block;
  }
  #shopify-section-{{ section.id }} .iq-imgtext__heading { margin: 0 0 1.5rem; }
  #shopify-section-{{ section.id }} .iq-imgtext__caption {
    text-transform: uppercase;
    letter-spacing: .1rem;
    font-size: 1.3rem;
    opacity: .7;
    margin: 0 0 1rem;
  }
  #shopify-section-{{ section.id }} .iq-imgtext__content .button { margin-top: 1rem; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .iq-imgtext__grid { grid-template-columns: 1fr; gap: 2rem; }
    #shopify-section-{{ section.id }} .iq-imgtext--reverse .iq-imgtext__media { order: 0; }
  }
</style>
<div class="iq-imgtext color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="iq-imgtext__grid{% if section.settings.image_position == 'right' %} iq-imgtext--reverse{% endif %}">
      <div class="iq-imgtext__media">
        {%- if section.settings.image_asset != blank -%}
          <img src="{{ section.settings.image_asset | asset_url }}" alt="" loading="lazy" width="800" height="800">
        {%- endif -%}
      </div>
      <div class="iq-imgtext__content">
        {%- if section.settings.caption != blank -%}
          <p class="iq-imgtext__caption">{{ section.settings.caption }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="iq-imgtext__heading h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "IQ Imagen + texto",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "image_asset", "label": "Imagen (nombre del asset)" },
    { "type": "select", "id": "image_position", "label": "Posición de la imagen", "options": [
      { "value": "left", "label": "Izquierda" }, { "value": "right", "label": "Derecha" }
    ], "default": "left" },
    { "type": "text", "id": "caption", "label": "Antetítulo" },
    { "type": "inline_richtext", "id": "heading", "label": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding arriba", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding abajo", "default": 48 }
  ],
  "presets": [{ "name": "IQ Imagen + texto" }]
}
{% endschema %}
