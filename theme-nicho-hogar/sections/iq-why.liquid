{%- comment -%} TiendaIQ — "¿Por qué elegirnos?" con imagen circular central + features alrededor {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .iq-why {
    background: linear-gradient(180deg, #ffffff 0%, {{ section.settings.gradient_color }} 100%);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .iq-why__head { text-align: center; max-width: 60rem; margin: 0 auto 4rem; }
  #shopify-section-{{ section.id }} .iq-why__title { margin: 0 0 1.2rem; }
  #shopify-section-{{ section.id }} .iq-why__sub { opacity: .8; font-size: 1.7rem; margin: 0; }
  #shopify-section-{{ section.id }} .iq-why__cols {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 420px) 1fr;
    align-items: center;
    gap: 3rem;
  }
  #shopify-section-{{ section.id }} .iq-why__center img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }
  #shopify-section-{{ section.id }} .iq-why__side { display: flex; flex-direction: column; gap: 3.5rem; }
  #shopify-section-{{ section.id }} .iq-why__feat { text-align: center; }
  #shopify-section-{{ section.id }} .iq-why__emoji { font-size: 2.6rem; line-height: 1; display: block; margin-bottom: .8rem; }
  #shopify-section-{{ section.id }} .iq-why__feat h3 { margin: 0 0 .6rem; font-size: 1.9rem; }
  #shopify-section-{{ section.id }} .iq-why__feat p { margin: 0; opacity: .8; font-size: 1.5rem; line-height: 1.5; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .iq-why__cols { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .iq-why__center { order: -1; max-width: 300px; margin: 0 auto 1rem; }
    #shopify-section-{{ section.id }} .iq-why__side { flex-direction: row; flex-wrap: wrap; }
    #shopify-section-{{ section.id }} .iq-why__feat { flex: 1 1 40%; }
  }
</style>
<div class="iq-why">
  <div class="page-width">
    <div class="iq-why__head">
      {%- if section.settings.title != blank -%}<h2 class="iq-why__title h1">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="iq-why__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
    <div class="iq-why__cols">
      <div class="iq-why__side">
        {%- for block in section.blocks -%}{%- if forloop.index <= 2 -%}
          <div class="iq-why__feat" {{ block.shopify_attributes }}>
            <span class="iq-why__emoji">{{ block.settings.emoji }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      <div class="iq-why__center">
        {%- if section.settings.image_asset != blank -%}
          <img src="{{ section.settings.image_asset | asset_url }}" alt="" loading="lazy" width="420" height="420">
        {%- endif -%}
      </div>
      <div class="iq-why__side">
        {%- for block in section.blocks -%}{%- if forloop.index > 2 -%}
          <div class="iq-why__feat" {{ block.shopify_attributes }}>
            <span class="iq-why__emoji">{{ block.settings.emoji }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "IQ Por qué elegirnos",
  "tag": "section",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "¿Por qué elegirnos?" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Nos enfocamos en resultados reales, ingredientes seguros y looks que te dan confianza." },
    { "type": "text", "id": "image_asset", "label": "Imagen central (asset)", "default": "iq-why.jpg" },
    { "type": "color", "id": "gradient_color", "label": "Color del gradiente", "default": "#FCE1EC" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding arriba", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding abajo", "default": 56 }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "text", "id": "emoji", "label": "Emoji", "default": "✨" },
      { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Descripción del beneficio." }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{ "name": "IQ Por qué elegirnos", "blocks": [{"type":"feature"},{"type":"feature"},{"type":"feature"},{"type":"feature"}] }]
}
{% endschema %}
