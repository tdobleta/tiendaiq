{%- comment -%} TiendaIQ — Hero con imagen de fondo desde assets del theme (pack por nicho) {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .iq-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.height }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .iq-hero__media,
  #shopify-section-{{ section.id }} .iq-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .iq-hero__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .iq-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: #fff;
    padding: 4rem 1.5rem;
    max-width: 78rem;
  }
  #shopify-section-{{ section.id }} .iq-hero__heading {
    color: #fff;
    margin: 0 auto 2rem;
    max-width: 46rem;
    text-shadow: 0 2px 18px rgba(0,0,0,.55), 0 1px 3px rgba(0,0,0,.4);
  }
</style>
<div class="iq-hero">
  <div class="iq-hero__media">
    {%- if section.settings.image_asset != blank -%}
      <img src="{{ section.settings.image_asset | asset_url }}" alt="" loading="eager" width="1600" height="900">
    {%- endif -%}
    <div class="iq-hero__overlay"></div>
  </div>
  <div class="iq-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="iq-hero__heading h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "IQ Hero",
  "tag": "section",
  "class": "iq-hero-section",
  "settings": [
    { "type": "text", "id": "image_asset", "label": "Imagen (nombre del asset)", "default": "iq-hero.jpg" },
    { "type": "range", "id": "height", "min": 320, "max": 900, "step": 20, "unit": "px", "label": "Alto", "default": 620 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Opacidad del overlay", "default": 25 },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Brillá con confianza" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver colección 💖" },
    { "type": "url", "id": "button_link", "label": "Link del botón" }
  ],
  "presets": [{ "name": "IQ Hero" }]
}
{% endschema %}
